# ==============================================================================
# PERSONAL INVESTMENT INTELLIGENCE PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Application Environment ---
APP_ENV=development                       # 'development' for local work, 'production' for cloud deployment
CLOUD_MODE=false                          # Set 'true' on Render / Vercel cloud deployment
LOG_LEVEL=INFO
TIMEZONE=Asia/Ho_Chi_Minh

# --- PostgreSQL Database (Neon Free or Local) ---
# For Neon: postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/investment
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_CONNECT_RETRIES=3

# --- Optional Redis (Upstash or Local) ---
# If not using Redis, set to NOT_CONFIGURED or leave empty (in-memory rate limiter will be used)
REDIS_URL=NOT_CONFIGURED

# --- Personal Application Authentication (Cloud Mode) ---
# Generate secret with: openssl rand -hex 32
# Generate password hash with: python -c "from services.auth.security import hash_password; print(hash_password('your_secure_password'))"
APP_AUTH_ENABLED=false                    # Set 'true' in cloud production
APP_AUTH_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
APP_AUTH_PASSWORD_HASH=pbkdf2_sha256$600000$salt_hex$hash_hex
APP_AUTH_EXPIRY_SECONDS=86400
COOKIE_SECURE=false                       # Set 'true' in production HTTPS

# --- External Cron Authentication (cron-job.org) ---
# Secret passed in 'X-Cron-Secret' header
CRON_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
ENABLE_IN_PROCESS_SCHEDULER=true          # Set 'false' on cloud (cron-job.org calls endpoints instead)

# --- CORS & Origin Allowlist ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Next.js Proxy Variables ---
INTERNAL_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI Providers & Zero-Budget Guardrails ---
AI_ALLOW_PAID_APIS=false                  # Strictly false: zero-budget personal deployment
AI_MONTHLY_BUDGET_USD=0
AI_PROVIDER_ORDER=gemini,groq,openrouter,ollama

# 1. Google Gemini (5 total attempts max: 1 initial + up to 4 retries)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_ENABLE_PREVIEW_MODELS=false
GEMINI_ENABLED=true
MAX_GEMINI_UPSTREAM_ATTEMPTS=5

# 2. Groq (Free developer tier)
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENABLED=false

# 3. OpenRouter (Strict free-only models ending with :free)
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_ENABLED=false

# 4. Ollama (Only if intentional secured network path is reachable from cloud)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b

# --- Market Data & Ingestion Flags ---
ENABLE_DNSE_INGESTION=false
ENABLE_VIETSTOCK_INGESTION=false
ENABLE_FRED_CSV_FALLBACK=true
INGESTION_LOOKBACK_DAYS=90
